#GIT COMMANDS

git config --global
        --for adding username

git config --global user.email "mailid"
        --for adding user.email

git init - for initializing git repository

git status - for listing untracked files

git add . --for adding untracked files to staged area

git commit -m "message" --for adding staged files into local repository

git remote add origin "remote repository path"
        --for connecting local repository with remote repository

git branch
        --showing the current branchname
        (default master/main)

git push origin branchname
        --for adding changes from local repository into remote repository

git log --for showing commit history

git remote -v
        --for showing remote repository details